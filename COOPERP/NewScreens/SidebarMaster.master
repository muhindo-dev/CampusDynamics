<%@ Master Language="C#" AutoEventWireup="true" CodeFile="SidebarMaster.master.cs" Inherits="COOPERP_NewScreens_SidebarMaster" %>

<%@ Register assembly="DevExpress.Web.v16.1, Version=16.1.4.0, Culture=neutral, PublicKeyToken=b88d1754d700e49a" namespace="DevExpress.Web" tagprefix="dx" %>

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head id="Head1" runat="server">
    <title>Campus Dynamics :: Faculty Module</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="content-type" content="text/html; charset=utf-8" />
    <link rel="shortcut icon" href="~/COOPERP/images/tinylogo.gif" />
    
    <!-- New Screen Styles Only - No external legacy CSS -->
    <link id="linkSidebar" rel="stylesheet" type="text/css" href="~/COOPERP/NewScreens/css/sidebar.css" runat="server" />
    <link id="linkTheme" rel="stylesheet" type="text/css" href="~/COOPERP/NewScreens/css/theme.css" runat="server" />
    
    <asp:ContentPlaceHolder ID="HeadContent" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server" EnableViewState="false">
        <asp:ScriptManager ID="ScriptManager1" runat="server"></asp:ScriptManager>
        
        <div class="cd-app">
            <!-- RBAC: hide the menu list until access filtering finishes, so users
                 never see a flash of items they cannot access. noscript + a load
                 fallback guarantee the menu can never stay hidden. -->
            <style>#sidebar:not(.rbac-ready) .cd-sidebar__menu{visibility:hidden;}</style>
            <noscript><style>#sidebar .cd-sidebar__menu{visibility:visible!important;}</style></noscript>
            <!-- Sidebar -->
            <aside class="cd-sidebar" id="sidebar">
                <div class="cd-sidebar__header">
                    <a href="#" id="linkBrand" runat="server" class="cd-sidebar__brand">
                        <asp:Image ID="imgLogo" runat="server" ImageUrl="~/COOPERP/images/tinylogo.gif" CssClass="cd-sidebar__logo" />
                        <span class="cd-sidebar__title">Mutesa I Royal University</span>
                    </a>
                    <button type="button" class="cd-sidebar__close" id="sidebarClose">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                    </button>
                </div>
                
                <nav class="cd-sidebar__nav">
                    <ul class="cd-sidebar__menu">

                        <!-- ══════════════════════════════════════════════
                             HOME — visible to all roles
                             ══════════════════════════════════════════════ -->
                        <li class="cd-sidebar__item" data-roles="all">
                            <asp:HyperLink ID="lnkDashboard" runat="server" NavigateUrl="~/COOPERP/NewScreens/NewDashboard.aspx" CssClass="cd-sidebar__link">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9"></rect><rect x="14" y="3" width="7" height="5"></rect><rect x="14" y="12" width="7" height="9"></rect><rect x="3" y="16" width="7" height="5"></rect></svg>
                                <span>Dashboard</span>
                            </asp:HyperLink>
                        </li>

                        <li class="cd-sidebar__item" data-roles="all">
                            <asp:HyperLink ID="lnkGeneralDashboard" runat="server" NavigateUrl="~/COOPERP/NewScreens/GeneralDashboard.aspx" CssClass="cd-sidebar__link">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"></rect><line x1="12" y1="3" x2="12" y2="21"></line><line x1="3" y1="12" x2="21" y2="12"></line></svg>
                                <span>General Dashboard</span>
