                <!-- Page Content -->
                <main class="cd-content">
                    <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                    </asp:ContentPlaceHolder>
                </main>
                
                <!-- Footer -->
                <footer class="cd-footer">
                    <dx:ASPxLabel ID="lbl_footer" runat="server" ForeColor="#666666" Font-Size="11px"></dx:ASPxLabel>
                </footer>
            </div>
        </div>
        
        <!-- Overlay for mobile -->
        <div class="cd-overlay" id="sidebarOverlay"></div>

        <!-- User role for sidebar filtering (Batch 13) -->
        <input type="hidden" id="cdUserRole" value="<%= (Session["usertype"] ?? "").ToString().ToLower() %>" />
    </form>
    
    <!-- Core Scripts -->
    <script type="text/javascript">
        (function() {
            'use strict';
            
            var sidebar = document.getElementById('sidebar');
            var sidebarToggle = document.getElementById('sidebarToggle');
            var sidebarClose = document.getElementById('sidebarClose');
            var sidebarOverlay = document.getElementById('sidebarOverlay');
            var submenuToggles = document.querySelectorAll('.cd-sidebar__link--toggle');
            var userDropdownTrigger = document.getElementById('userDropdownTrigger');
            var userDropdownMenu = document.getElementById('userDropdownMenu');
            
            function init() {
                applyMenuAccessFilter();
                // Reveal the menu as soon as filtering is done (before the rest of
                // init, which could throw) so the final, filtered menu is what paints.
                var _sb = document.getElementById('sidebar');
                if (_sb) _sb.classList.add('rbac-ready');

                if (sidebarToggle) sidebarToggle.addEventListener('click', openSidebar);
                if (sidebarClose) sidebarClose.addEventListener('click', closeSidebar);
                if (sidebarOverlay) sidebarOverlay.addEventListener('click', closeSidebar);
                
                submenuToggles.forEach(function(toggle) {
                    toggle.addEventListener('click', handleSubmenuToggle);
                });
                
                window.addEventListener('resize', handleResize);
                setActiveMenuItem();
                loadSidebarBadges();
            }
            
            function openSidebar() {
                if (sidebar) sidebar.classList.add('open');
                if (sidebarOverlay) sidebarOverlay.classList.add('show');
                document.body.style.overflow = 'hidden';
            }
            
            function closeSidebar() {
                if (sidebar) sidebar.classList.remove('open');
                if (sidebarOverlay) sidebarOverlay.classList.remove('show');
                document.body.style.overflow = '';
            }
            
            function handleSubmenuToggle(e) {
                e.preventDefault();
                var parentItem = this.closest('.cd-sidebar__item--has-submenu');
                if (parentItem) {
                    document.querySelectorAll('.cd-sidebar__item--has-submenu').forEach(function(item) {
                        if (item !== parentItem && item.classList.contains('open')) {
                            item.classList.remove('open');
                        }
                    });
                    parentItem.classList.toggle('open');
                }
            }
            
            function handleResize() {
                if (window.innerWidth > 992) closeSidebar();
            }
            
            // ── Role-Based Menu Filtering (Batch 13) ──────────────────────
            function filterMenuByRole() {
                var roleEl = document.getElementById('cdUserRole');
                var userRole = roleEl ? roleEl.value.trim().toLowerCase() : '';
                if (!userRole) return; // don't filter if role unknown

                function normalizeRoleName(roleName) {
                    return (roleName || '')
                        .toLowerCase()
                        .replace(/[^a-z0-9]+/g, '_')
                        .replace(/^_+|_+$/g, '');
                }

                function getRoleAliases(roleName) {
                    var normalized = normalizeRoleName(roleName);
                    var aliases = [normalized];

                    if (normalized === 'administrator') aliases.push('admin');
                    if (normalized === 'admin') aliases.push('administrator');

                    if (normalized === 'finance_officer' || normalized === 'finance') {
                        aliases.push('accountant');
                    }

                    if (normalized === 'accountant') {
                        aliases.push('finance_officer');
                    }

                    if (normalized === 'bursar') {
                        aliases.push('finance_officer', 'accountant', 'admin');
                    }

                    if (normalized === 'hr') {
                        aliases.push('hr_manager', 'human_resource', 'human_resources');
                    }

                    if (normalized === 'hr_manager') {
                        aliases.push('hr', 'human_resource', 'human_resources');
                    }

                    if (normalized === 'human_resource' || normalized === 'human_resources') {
                        aliases.push('hr_manager', 'hr');
                    }

                    return aliases;
                }

                var userRoleAliases = getRoleAliases(userRole);

                var items = document.querySelectorAll('[data-roles]');
                for (var i = 0; i < items.length; i++) {
                    var allowed = items[i].getAttribute('data-roles');
                    if (!allowed) continue;
                    if (allowed === 'all') continue;
                    var roles = allowed.split(/\s+/);
                    var match = false;
                    for (var r = 0; r < roles.length; r++) {
                        var allowedRole = normalizeRoleName(roles[r]);
                        for (var a = 0; a < userRoleAliases.length; a++) {
                            if (allowedRole === userRoleAliases[a]) {
                                match = true;
                                break;
                            }
                        }
                        if (match) break;
                    }
                    if (!match) {
                        items[i].style.display = 'none';
                    }
                }
            }

            // ── Access-driven menu filtering ──────────────────────────────────
            // Single source of truth = the user's granted slug set (the SAME
            // decision as page access). Show a menu item  ⇔  the user can open
            // its page. Fail-safe everywhere: admins ('*'), users with NO role
            // (empty slug set), the kill-switch (cdMenuFilter=false), unmapped
            // links, and any error all leave the full menu visible — so menu
            // filtering can never lock anyone out. Filtering only "bites" once a
            // user has a role assigned.
            function fileFromHref(href){
                return (href || '').split('?')[0].split('#')[0]
                        .replace(/\/+$/, '').split('/').pop().toLowerCase();
            }

            function applyMenuAccessFilter() {
                try {
                    if (window.cdMenuFilter === false) return;          // kill-switch → show all
                    var allowed = window.cdAllowedSlugs;
                    if (allowed === '*') return;                        // admin (super admin) → show all
                    if (allowed == null) return;                        // not loaded (not logged in) → fail-safe show all

                    // Super-admin-only items are hidden for every non-admin (admins
                    // already returned above), regardless of any slug grants.
                    var sa = document.querySelectorAll('[data-superadmin]');
                    for (var z = 0; z < sa.length; z++) sa[z].style.display = 'none';

                    // `allowed` is an array of granted slugs. An EMPTY array means
                    // the user has no role → everything access-controlled is hidden
                    // (only the Dashboard + non-controlled links remain).
                    var allow = {};
                    for (var i = 0; i < allowed.length; i++) allow[String(allowed[i]).toLowerCase()] = 1;
                    var map = window.cdUrlSlugMap || {};

                    var links = document.querySelectorAll('.cd-sidebar__sublink, .cd-sidebar__link');
                    for (var j = 0; j < links.length; j++) {
                        var href = links[j].getAttribute('href') || '';
                        if (!href || href === '#' || href.indexOf('javascript:') === 0) continue;
                        var slug = map[fileFromHref(href)];
                        if (!slug) continue;                            // unmapped page → keep visible
                        if (slug.toLowerCase().indexOf('home') === 0) continue;  // Dashboard always visible
                        if (!allow[slug.toLowerCase()]) {
                            var li = links[j].closest ? links[j].closest('li') : null;
                            if (li) li.style.display = 'none';
                        }
                    }
                    collapseEmptyGroups();
                } catch (e) { /* fail open: leave the menu visible */ }
            }

            function collapseEmptyGroups() {
                // 1) hide submenu parents whose children are all hidden
                var parents = document.querySelectorAll('.cd-sidebar__item--has-submenu');
                for (var p = 0; p < parents.length; p++) {
                    var subs = parents[p].querySelectorAll('.cd-sidebar__subitem');
                    if (!subs.length) continue;
                    var vis = false;
                    for (var s = 0; s < subs.length; s++)
                        if (subs[s].style.display !== 'none') { vis = true; break; }
                    if (!vis) parents[p].style.display = 'none';
                }
                // 2) hide section headings whose whole section is now empty
                var headings = document.querySelectorAll('.cd-sidebar__menu > .cd-sidebar__heading');
                for (var h = 0; h < headings.length; h++) {
                    var anyVisible = false, n = headings[h].nextElementSibling;
                    while (n && !n.classList.contains('cd-sidebar__heading')) {
                        if (n.style.display !== 'none' &&
                            (n.classList.contains('cd-sidebar__item') || n.classList.contains('cd-sidebar__subitem'))) {
                            anyVisible = true; break;
                        }
                        n = n.nextElementSibling;
                    }
                    if (!anyVisible) headings[h].style.display = 'none';
                }
            }

            // ── Sidebar Badges (Batch 13) ──────────────────────────────────
            function loadSidebarBadges() {
                // DeanApproval pending count badge
                var deanLink = document.getElementById('lnkDeanApproval');
                if (!deanLink || deanLink.style.display === 'none') return;
                // Only load for approval roles
                var roleEl = document.getElementById('cdUserRole');
                var role = roleEl ? roleEl.value.trim().toLowerCase() : '';
                var approvalRoles = ['dean', 'administrator', 'admin'];
                var isApprover = false;
                for (var i = 0; i < approvalRoles.length; i++) {
                    if (approvalRoles[i] === role) { isApprover = true; break; }
                }
                if (!isApprover) return;

                var xhr = new XMLHttpRequest();
                xhr.open('POST', 'DeanApproval.aspx?ajax=stats', true);
                xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
                xhr.onreadystatechange = function () {
                    if (xhr.readyState !== 4 || xhr.status !== 200) return;
                    try {
                        var d = JSON.parse(xhr.responseText);
                        if (d.pending && parseInt(d.pending, 10) > 0) {
                            var badge = document.createElement('span');
                            badge.className = 'cd-sidebar__badge';
                            badge.textContent = d.pending;
                            deanLink.appendChild(badge);
                        }
                    } catch (ex) { /* silent */ }
                };
                // Send minimal request with CSRF if available
                var csrfMeta = document.querySelector('meta[name="csrf-token"]');
                var body = csrfMeta ? '__csrf=' + encodeURIComponent(csrfMeta.getAttribute('content')) : '';
                xhr.send(body);
            }

            function setActiveMenuItem() {
                // Get current page path (without query string)
                var currentPath = window.location.pathname.toLowerCase();
                var currentFileName = currentPath.split('/').pop().split('?')[0];
                
                // Get query string parameters
                var urlParams = new URLSearchParams(window.location.search);
                var statusParam = urlParams.get('status');
                
                var menuLinks = document.querySelectorAll('.cd-sidebar__link, .cd-sidebar__sublink');
                var foundActive = false;
                
                menuLinks.forEach(function(link) {
                    var href = link.getAttribute('href');
                    if (href && href !== '#' && href !== 'javascript:void(0)') {
                        var linkPath = href.toLowerCase();
                        var linkFileName = linkPath.split('/').pop().split('?')[0];
                        
                        // Special handling for student status pages
                        // ActiveStudents.aspx, AdmittedStudents.aspx, AlumniStudents.aspx, AllStudents.aspx
                        // all redirect to NewStudentInfo.aspx with status parameter
                        var isStudentStatusPage = (currentFileName === 'newstudentinfo.aspx' && statusParam);
                        
                        if (isStudentStatusPage) {
                            // Map status parameter to the redirect page
                            var statusToPage = {
                                'ACTIVE': 'activestudents.aspx',
                                'ADMITTED': 'admittedstudents.aspx',
                                'ALUMNI': 'alumnistudents.aspx',
                                'ALL': 'allstudents.aspx'
                            };
                            var expectedPage = statusToPage[statusParam.toUpperCase()];
                            
                            if (expectedPage && linkFileName === expectedPage) {
                                link.classList.add('active');
                                foundActive = true;
                                var parentSubmenu = link.closest('.cd-sidebar__item--has-submenu');
                                if (parentSubmenu) parentSubmenu.classList.add('open');
                            }
                        } else {
                            // Standard matching - compare file names
                            if (currentFileName && linkFileName && currentFileName === linkFileName) {
                                link.classList.add('active');
                                foundActive = true;
                                var parentSubmenu = link.closest('.cd-sidebar__item--has-submenu');
                                if (parentSubmenu) parentSubmenu.classList.add('open');
                            }
                        }
                    }
                });
                
                // If we're on NewStudentInfo without a status param (direct access), 
                // mark All Students as active
                if (!foundActive && currentFileName === 'newstudentinfo.aspx') {
                    var allStudentsLink = document.querySelector('a[href*="AllStudents.aspx"]');
                    if (allStudentsLink) {
                        allStudentsLink.classList.add('active');
                        var parentSubmenu = allStudentsLink.closest('.cd-sidebar__item--has-submenu');
                        if (parentSubmenu) parentSubmenu.classList.add('open');
                    }
                }
            }
            
            // User Dropdown Toggle
            function toggleUserDropdown(e) {
                e.stopPropagation();
                if (userDropdownMenu) {
                    userDropdownMenu.classList.toggle('show');
                }
            }
            
            function closeUserDropdown() {
                if (userDropdownMenu) {
                    userDropdownMenu.classList.remove('show');
                }
            }
            
            // Initialize dropdown
            if (userDropdownTrigger) {
                userDropdownTrigger.addEventListener('click', toggleUserDropdown);
            }
            
            // Close dropdown when clicking outside
            document.addEventListener('click', function(e) {
                if (userDropdownMenu && !userDropdownMenu.contains(e.target) && e.target !== userDropdownTrigger) {
                    closeUserDropdown();
                }
            });
            
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    if (sidebar && sidebar.classList.contains('open')) {
                        closeSidebar();
                    }
                    closeUserDropdown();
                    // Close any open action popovers
                    closeAllActionPopovers();
                }
            });
            
            // ============================================
            // Action Popover Menu - Global Functions
            // ============================================
            window.closeAllActionPopovers = function() {
                document.querySelectorAll('.cd-action-popover.show').forEach(function(popover) {
                    popover.classList.remove('show');
                });
            };
            
            window.toggleActionPopover = function(btn, event) {
                if (event) {
                    event.preventDefault();
                    event.stopPropagation();
                }
                
                var wrapper = btn.closest('.cd-action-wrapper');
                var popover = wrapper ? wrapper.querySelector('.cd-action-popover') : null;
                
                if (!popover) return;
                
                var isOpen = popover.classList.contains('show');
                
                // Close all other popovers first
                closeAllActionPopovers();
                
                if (!isOpen) {
                    popover.classList.add('show');
                    
                    // Check if popover goes below viewport and flip if needed
                    setTimeout(function() {
                        var rect = popover.getBoundingClientRect();
                        if (rect.bottom > window.innerHeight) {
                            popover.classList.add('cd-action-popover--top');
                        } else {
                            popover.classList.remove('cd-action-popover--top');
                        }
                    }, 0);
                }
            };
            
            // Close popovers when clicking outside
            document.addEventListener('click', function(e) {
                if (!e.target.closest('.cd-action-wrapper')) {
                    closeAllActionPopovers();
                }
                if (userDropdownMenu && !userDropdownMenu.contains(e.target) && e.target !== userDropdownTrigger) {
                    closeUserDropdown();
                }
            });
            
            // DevExpress Grid Edit/Delete handler
            window.gridEditRow = function(gridClientId, keyValue) {
                var grid = ASPxClientControl.GetControlCollection().GetByName(gridClientId);
                if (grid) {
                    grid.StartEditRowByKey(keyValue);
                }
                closeAllActionPopovers();
            };
            
            window.gridDeleteRow = function(gridClientId, keyValue) {
                if (confirm('Are you sure you want to delete this record?')) {
                    var grid = ASPxClientControl.GetControlCollection().GetByName(gridClientId);
                    if (grid) {
                        grid.DeleteRowByKey(keyValue);
                    }
                }
                closeAllActionPopovers();
            };
            
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', init);
            } else {
                init();
            }

            // Safety net: even if init() ever fails, never leave the menu hidden.
            window.addEventListener('load', function () {
                var s = document.getElementById('sidebar');
                if (s) s.classList.add('rbac-ready');
            });
        })();
    </script>
</body>
</html>
